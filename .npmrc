# react-helmet-async@2 still declares a React <=18 peer while this project runs
# React 19, so a strict resolver refuses the tree. Every CI workflow already
# passes --legacy-peer-deps; build environments that run a bare
# `npm clean-install` (Cloudflare Workers/Pages Builds) take no flags, so the
# setting has to live here or those builds fail at install.
legacy-peer-deps=true
